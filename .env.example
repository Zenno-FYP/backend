# -----------------------------------------------------------------------------
# Zenno backend environment template
# Copy to `.env` for local development. Do not commit real secrets.
# -----------------------------------------------------------------------------

# App
PORT=3000
ENABLE_SWAGGER=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/zenno

# CORS allowlist (comma-separated origins)
# Example:
# CORS_ORIGINS=http://localhost:3001,https://app.example.com
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000

# Firebase Admin SDK service account (server-side secrets)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep newline characters escaped as \n when using .env files:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="paste-private-key-with-escaped-newlines"

# Cloudinary (optional, for profile image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
